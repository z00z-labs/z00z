#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

VERSION_MANAGER_REL=".github/skills/z00z-git-versioning/scripts/version-manager.sh"

log() {
    printf '[pre-commit] %s\n' "$1"
}

fail() {
    printf '[pre-commit] %s\n' "$1" >&2
    exit 1
}

is_zero_oid() {
    [[ "$1" =~ ^0+$ ]]
}

has_ancestor_command() {
    local needle="$1"
    local current_pid="$PPID"
    local cmd_line
    local parent_pid

    while [[ -n "$current_pid" ]] && [[ "$current_pid" =~ ^[0-9]+$ ]] && [[ "$current_pid" -gt 1 ]]; do
        cmd_line="$(ps -o args= -p "$current_pid" 2>/dev/null || true)"
        if [[ "$cmd_line" == *"$needle"* ]]; then
            return 0
        fi

        parent_pid="$(ps -o ppid= -p "$current_pid" 2>/dev/null | tr -d ' ' || true)"
        [[ -n "$parent_pid" ]] || break
        current_pid="$parent_pid"
    done

    return 1
}

mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMRD)

if [[ "${#STAGED_FILES[@]}" -eq 0 ]]; then
    log 'No staged files to validate'
    exit 0
fi

vendor_touched=0
version_file_touched=0
rust_related_touched=0
strict_check_files=()
help_english_touched=0

for file_path in "${STAGED_FILES[@]}"; do
    case "$file_path" in
        crates/z00z_crypto/tari/*)
            vendor_touched=1
            ;;
        versions.yaml)
            version_file_touched=1
            ;;
        *.rs|Cargo.toml)
            rust_related_touched=1
            ;;
    esac

    case "$file_path" in
        *.md|*.txt)
            ;;
        *)
            strict_check_files+=("$file_path")
            ;;
    esac

    case "$file_path" in
        crates/z00z_ui_ux/demo/help/en/*.md|crates/z00z_ui_ux/demo/help/en/*.yaml|crates/z00z_ui_ux/demo/help/en/*.yml)
            help_english_touched=1
            ;;
    esac
done

if git diff --cached --name-only --diff-filter=D -- crates/z00z_ui_ux/demo/help/en | grep -q .; then
    help_english_touched=1
fi

if [[ "$vendor_touched" -eq 1 ]]; then
    fail "Vendor subtree crates/z00z_crypto/tari/ is read-only. Move integration changes into z00z_crypto wrappers instead."
fi

if [[ "$version_file_touched" -eq 1 ]] && ! has_ancestor_command "$VERSION_MANAGER_REL"; then
    fail "Direct commits that stage versions.yaml are blocked. Use ./$VERSION_MANAGER_REL ... so the version bump, commit, and tag stay consistent."
fi

if [[ "${#strict_check_files[@]}" -gt 0 ]]; then
    if ! git diff --cached --check --color=never -- "${strict_check_files[@]}" >/tmp/z00z-pre-commit-check.$$ 2>&1; then
        cat /tmp/z00z-pre-commit-check.$$ >&2
        rm -f /tmp/z00z-pre-commit-check.$$
        fail 'Staged non-markdown/non-text diff contains conflict markers or whitespace errors.'
    fi
fi
rm -f /tmp/z00z-pre-commit-check.$$

if [[ "$help_english_touched" -eq 1 ]]; then
    demo_rel="crates/z00z_ui_ux/demo"
    log 'Synchronizing all Help locales from staged help/en changes'
    sync_json="$(cd "$demo_rel" && node scripts/sync-help.mjs --json)"
    mapfile -t synced_paths < <(
        printf '%s' "$sync_json" \
            | node -e 'let input=""; process.stdin.on("data", chunk => input += chunk); process.stdin.on("end", () => JSON.parse(input).paths.forEach(path => console.log(path)));'
    )
    (
        cd "$demo_rel"
        node scripts/compile-help.mjs
        node scripts/check-help.mjs
    )
    git add -- \
        "$demo_rel/help/source-state.json" \
        "$demo_rel/scripts/generated/help-catalog.js"
    for synced_path in "${synced_paths[@]}"; do
        git add -- "$demo_rel/$synced_path"
    done
    log "Help locale synchronization staged (${#synced_paths[@]} localized files updated)"
fi

if [[ "$rust_related_touched" -eq 1 ]]; then
    log 'Running cargo fmt --all --check'
    cargo fmt --all --check
fi

log 'Hook checks passed'
exit 0
